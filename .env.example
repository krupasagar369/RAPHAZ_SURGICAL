# Public site URL (used for canonical URLs, sitemap and Open Graph). Set to your live domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp business number in international format (digits only, no +).
NEXT_PUBLIC_WHATSAPP_NUMBER=919611051111

# Number used for click-to-call. If omitted, the WhatsApp number above is used.
# Set this once the business confirms a separate phone line.
NEXT_PUBLIC_PHONE_NUMBER=919611051111
